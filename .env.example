# Docker Compose database credential (required)
POSTGRES_PASSWORD=

# PostgreSQL URL for host-side commands; Compose overrides this for containers
VSM_DATABASE_URL=postgresql://virtual_self:<password>@127.0.0.1:54329/virtual_self

# 32+ byte secret for Fernet field encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VSM_FIELD_ENCRYPTION_KEY=

# Bootstrap admin token (hashed at rest after first credential insert via CLI)
VSM_BOOTSTRAP_TOKEN=

# API
VSM_API_HOST=127.0.0.1
VSM_API_PORT=8090
VSM_LOG_LEVEL=INFO
VSM_METRICS_ENABLED=true

# Worker
VSM_WORKER_ENABLED=true
VSM_WORKER_POLL_SECONDS=2

# Read-only corpus (bind-mounted at /corpus inside Docker)
VSM_MY_LIFE_ROOT=./private/corpus
# In containers, compose overrides VSM_MY_LIFE_ROOT=/corpus and LLM URLs to host.docker.internal

# Embeddings (Ollama on host — required for semantic memory)
VSM_OLLAMA_URL=http://127.0.0.1:11434
VSM_EMBED_MODEL=nomic-embed-text
VSM_EMBED_DIMS=768
VSM_LLM_BACKEND=auto
VSM_OPENAI_BASE_URL=http://127.0.0.1:8081/v1
VSM_OPENAI_MODEL=local
VSM_OPENAI_API_KEY=
VSM_CHAT_MODEL=local
VSM_CHAT_TIMEOUT_SECONDS=180
VSM_REQUIRE_AGENT_ENRICHMENT=true
VSM_ENRICH_ON_IMPORT=true
VSM_ENRICH_THAW_COLD_MODEL=false

# Chat → long-term memory (classifier runs async via worker; small Ollama model, not :8081 chat)
VSM_CHAT_MEMORY_ENABLED=true
VSM_CHAT_MEMORY_MODEL=qwen2.5:7b
VSM_CHAT_MEMORY_LLM_BACKEND=ollama
VSM_CHAT_MEMORY_MIN_CONFIDENCE=0.85
VSM_CHAT_MEMORY_TURN_WINDOW=6
VSM_CHAT_MEMORY_NOTIFY_ON_SAVE=false

# Optional notifier
VSM_NOTIFY_ENABLED=false
VSM_NOTIFIER_URL=
VSM_NOTIFY_LABEL=Virtual Self
VSM_NOTIFY_DEDUPE_MINUTES=15
# Opt-in progress noise (default off)
VSM_ENRICH_NOTIFY_MILESTONES=false
VSM_NOTIFY_ARCHIVE_ZIP=false
VSM_NOTIFY_ARCHIVE_DOWNLOAD=false
# Tests set VSM_NOTIFY_ENABLED=false; use VSM_NOTIFY_ALLOW_IN_TESTS=true only in notify unit tests

# SearXNG (profile web — W-2; generate: openssl rand -hex 32)
SEARXNG_SECRET_KEY=
SEARXNG_PORT=8098

# knowledge-gateway (profile web — W-3; littleoffice/mcp-searxng-relay; generate: openssl rand -hex 32)
WEB_GATEWAY_MCP_TOKEN=
WEB_GATEWAY_PORT=8099
# vself client (W-5/W-6): MCP base; host tools use 127.0.0.1:8099, api/worker/chat use compose default
# VSM_WEB_GATEWAY_URL=http://127.0.0.1:8099

# Personal data archive (Takeout / Meta inbox)
VSM_ARCHIVE_DATA_ROOT=./private/archive
VSM_ARCHIVE_ENABLED=true
VSM_ARCHIVE_RCLONE_CONFIG=./private/rclone.conf
VSM_ARCHIVE_RCLONE_REMOTE=
VSM_ARCHIVE_TAKEOUT_PATH=Takeout
VSM_ARCHIVE_SYNC_POLL_SECONDS=900
VSM_ARCHIVE_STABILITY_POLL_SECONDS=60
VSM_ARCHIVE_MIN_FREE_GB=15
VSM_ARCHIVE_STREAMING=true
VSM_ARCHIVE_DELETE_ZIP_AFTER=false
VSM_ARCHIVE_MIN_CONFIDENCE=0.8
VSM_ARCHIVE_LLM_ENABLED=true
VSM_ARCHIVE_SUPERVISOR_ENABLED=true
